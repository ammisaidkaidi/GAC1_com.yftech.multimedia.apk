<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="center_vertical" android:id="@android:id/background" android:height="96.0px">
        <layer-list>
            <item android:height="96.0px">
                <shape>
                    <gradient android:startColor="@android:color/transparent" android:endColor="@android:color/transparent" android:angle="0.0" android:centerX="0.5" android:centerColor="@android:color/transparent" />
                </shape>
            </item>
            <item android:gravity="center_vertical" android:height="4.0px">
                <shape>
                    <gradient android:startColor="@color/color1ACCDDFF" android:endColor="@color/color1ACCDDFF" android:angle="0.0" android:centerX="0.5" android:centerColor="@color/color1ACCDDFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:gravity="center_vertical" android:id="@android:id/progress" android:height="96.0px">
        <clip>
            <layer-list>
                <item android:gravity="center_vertical" android:height="4.0px">
                    <shape>
                        <gradient android:startColor="@color/colorFEA317" android:endColor="@color/colorF2FFFFFF" android:angle="0.0" android:centerX="0.67" android:centerColor="@color/colorFDD647" />
                    </shape>
                </item>
            </layer-list>
        </clip>
    </item>
</layer-list>
