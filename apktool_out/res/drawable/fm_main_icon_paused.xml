<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <bitmap android:src="@mipmap/radio_icon_buttons_play" android:alpha="0.6" />
    </item>
    <item android:state_enabled="false">
        <bitmap android:src="@mipmap/radio_icon_buttons_play" android:alpha="0.5" />
    </item>
    <item android:state_hovered="true">
        <bitmap android:src="@mipmap/radio_icon_buttons_play" android:alpha="0.5" />
    </item>
    <item android:drawable="@mipmap/radio_icon_buttons_play" />
</selector>
