<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:background="@android:color/black" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="ltr"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView android:id="@id/iv_background" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@mipmap/pv_bg_error" android:scaleType="center" />
    <LinearLayout android:gravity="center_horizontal" android:layout_gravity="center" android:orientation="vertical" android:id="@id/lin_searching" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <ProgressBar android:layout_width="150.0px" android:layout_height="150.0px" android:indeterminateDrawable="@drawable/progress_loading" android:indeterminateDuration="200" />
        <TextView android:textSize="36.0px" android:textColor="@color/colorB3FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="62.0px" android:text="@string/music_list_searching" />
    </LinearLayout>
    <LinearLayout android:gravity="center_horizontal" android:layout_gravity="center" android:orientation="vertical" android:id="@id/lin_search_fail" android:paddingTop="30.0px" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="match_parent">
        <ImageView android:layout_width="400.0px" android:layout_height="360.0px" android:src="@mipmap/music_error_search" android:scaleType="fitCenter" />
        <TextView android:textSize="36.0px" android:textColor="@color/colorB3FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/music_list_no_content_searched" />
    </LinearLayout>
    <LinearLayout android:orientation="vertical" android:id="@id/lin_list" android:visibility="visible" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginStart="30.0px" android:layout_marginEnd="30.0px">
        <LinearLayout android:orientation="horizontal" android:paddingTop="15.0px" android:paddingBottom="15.0px" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15.0px">
            <TextView android:textSize="28.0px" android:textColor="@color/colorB3FFFFFF" android:gravity="center_vertical" android:layout_width="56.0px" android:layout_height="40.0px" android:text="@string/music_list_from_usb_title_0" />
            <TextView android:textSize="28.0px" android:textColor="@color/colorB3FFFFFF" android:gravity="center_vertical" android:id="@id/tv_num" android:layout_width="160.0px" android:layout_height="40.0px" android:text="（149）" />
            <TextView android:textSize="28.0px" android:textColor="@color/colorB3FFFFFF" android:gravity="center_vertical" android:layout_width="210.0px" android:layout_height="40.0px" android:text="@string/music_list_from_usb_title_1" android:layout_marginStart="392.0px" />
            <TextView android:textSize="28.0px" android:textColor="@color/colorB3FFFFFF" android:gravity="center_vertical" android:layout_width="278.0px" android:layout_height="40.0px" android:text="@string/music_list_from_usb_title_2" android:layout_marginStart="80.0px" />
        </LinearLayout>
        <View android:background="@color/color1ACCDDFF" android:layout_width="match_parent" android:layout_height="2.0px" />
        <androidx.recyclerview.widget.RecyclerView android:id="@id/rv" android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never" />
    </LinearLayout>
</FrameLayout>
